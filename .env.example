# ============================================
# ResearchScout Environment Variables
# ============================================
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────
APP_NAME=ResearchScout
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ADMIN_API_KEY=replace-with-a-random-admin-key-at-least-32-chars
CORS_ORIGINS=["http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=researchscout
POSTGRES_USER=researchscout
POSTGRES_PASSWORD=researchscout_dev_password
DATABASE_URL=postgresql+asyncpg://researchscout:researchscout_dev_password@postgres:5432/researchscout

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Qdrant ───────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# ── Neo4j ────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchscout_neo4j

# ── MinIO (S3-compatible) ────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=researchscout

# ── LLM APIs ────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-google-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
ANTHROPIC_API_KEY=your-anthropic-key

# ── Embedding ────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ── Search APIs ──────────────────────────────
GOOGLE_CSE_API_KEY=your-google-cse-key
GOOGLE_CSE_CX=your-search-engine-id
BING_SEARCH_API_KEY=your-bing-key
TAVILY_API_KEY=your-tavily-key
SERPAPI_API_KEY=your-serpapi-key

# ── Notifications ────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=notifications@researchscout.io
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
DISCORD_WEBHOOK_URL=your-discord-webhook

# ── Auth ─────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Crawling ─────────────────────────────────
CRAWLER_USER_AGENT=ResearchScoutBot/1.0 (+https://researchscout.io/bot)
CRAWLER_DEFAULT_RATE_LIMIT=1.0
CRAWLER_MAX_CONCURRENT=10
CRAWLER_TIMEOUT_SECONDS=30
